# Local demo settings. Compose binds every published service to 127.0.0.1.
POSTGRES_DB=trades
POSTGRES_USER=trades
POSTGRES_PASSWORD=trades
API_PORT=8080
UI_PORT=4200
POSTGRES_PORT=5432
KAFKA_EXTERNAL_PORT=29092
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# API database pool tuning
DB_POOL_SIZE=20
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000
TRADE_PERSISTENCE_ADAPTER=jdbc

# Ingestion safeguards and write batching
TRADE_WRITE_BATCH_SIZE=1000
TRADE_MAX_CSV_ROWS=1000000
TRADE_MAX_FILE_SIZE=25MB
TRADE_MAX_REQUEST_SIZE=26MB

# Kafka topic, producer timeout, consumer parallelism and retry behavior
KAFKA_TRADE_TOPIC=trades.intraday
KAFKA_TRADE_PARTITIONS=3
KAFKA_TRADE_REPLICAS=1
KAFKA_TOPIC_MUREX=trades.murex
KAFKA_TOPIC_CALYPSO=trades.calypso
KAFKA_PARTITIONS_MUREX=3
KAFKA_PARTITIONS_CALYPSO=3
KAFKA_CONSUMER_GROUP_ID=trade-capture-api
KAFKA_CONCURRENCY=3
KAFKA_CONSUMER_ENABLED=true
# Optional comma-separated topic override, for example trades.murex.
KAFKA_CONSUMER_TOPICS=
KAFKA_MAX_POLL_RECORDS=100
KAFKA_MAX_POLL_INTERVAL_MS=300000
KAFKA_POLL_TIMEOUT=1s
KAFKA_DLT_SUFFIX=.DLT
KAFKA_PUBLISH_TIMEOUT=10s
KAFKA_RETRY_BACKOFF=1s
KAFKA_RETRY_ATTEMPTS=3
